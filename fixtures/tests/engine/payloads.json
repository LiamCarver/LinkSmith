        "mode": "file",
        "cardinality": "one"
      }
    ],
    "steps": [
      {
        "id": "summaries",
        "invocations": [
          {
            "id": "principles",
            "service": "summarize-principles"
          },
          {
            "id": "jobs",
            "service": "summarize-jobs"
          }
        ]
      },
      {
        "id": "questioning",
        "invocations": [
          {
            "id": "combine",
            "service": "build-question-set"
          }
        ]
      }
    ],
    "edges": [
      {
        "from": "pipeline:input.principles",
        "to": "summaries.principles.principles"
      },
      {
        "from": "pipeline:input.jobs",
        "to": "summaries.jobs.jobs"
      },
      {
        "from": "summaries.principles.summary",
        "to": "questioning.combine.principles_summary"
      },
      {
        "from": "summaries.jobs.summary",
        "to": "questioning.combine.jobs_summary"
      },
      {
        "from": "questioning.combine.questions",
        "to": "pipeline:output.questions"
      }
    ]
  },
