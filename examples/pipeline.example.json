{
  "id": "canvas-team-analysis",
  "name": "Canvas Team Analysis",
  "description": "Combine a canvas, team principles, and job descriptions to generate questions, analysis artifacts, and Markdown reports.",
  "version": "0.1.0",
  "inputs": [
    {
      "name": "canvas",
      "type": "application/vnd.obsidian.canvas+json",
      "mode": "file",
      "cardinality": "one",
      "description": "Source Obsidian canvas."
    },
    {
      "name": "team-principles",
      "type": "text/markdown",
      "mode": "directory",
      "cardinality": "many",
      "description": "Company principles folder."
    },
    {
      "name": "job-descriptions",
      "type": "text/markdown",
      "mode": "directory",
      "cardinality": "many",
      "description": "Job descriptions folder."
    },
    {
      "name": "manual-answers",
      "type": "application/json",
      "mode": "file",
      "cardinality": "one",
      "description": "Manual answers captured after reviewing the generated questions."
    }
  ],
  "outputs": [
    {
      "name": "questions",
      "type": "application/json",
      "mode": "artifact-ref",
      "cardinality": "one",
      "description": "Generated questions list."
    },
    {
      "name": "risks-report",
      "type": "text/markdown",
      "mode": "artifact-ref",
      "cardinality": "one",
      "description": "Rendered Markdown risk report."
    },
    {
      "name": "team-leverage-report",
      "type": "text/markdown",
      "mode": "artifact-ref",
      "cardinality": "one",
      "description": "Rendered Markdown team leverage report."
    }
  ],
  "steps": [
    {
      "id": "prepare_context",
      "description": "Prepare structured JSON context from the canvas and Markdown sources.",
      "invocations": [
        {
          "id": "canvas",
          "service": "obsidian-canvas-to-json",
          "description": "Infer relationship structure from the canvas.",
          "inputs": [
            {
              "servicePort": "canvas"
            }
          ],
          "outputs": [
            {
              "servicePort": "relationships"
            }
          ]
        },
        {
          "id": "principles",
          "service": "markdown-folder-to-summary-json",
          "description": "Summarize company principles into structured JSON.",
          "config": {
            "mode": "principles"
          },
          "inputs": [
            {
              "servicePort": "documents"
            }
          ],
          "outputs": [
            {
              "servicePort": "summary"
            }
          ]
        },
        {
          "id": "jobs",
          "service": "markdown-folder-to-summary-json",
          "description": "Summarize job descriptions into structured JSON.",
          "config": {
            "mode": "job-descriptions"
          },
          "inputs": [
            {
              "servicePort": "documents"
            }
          ],
          "outputs": [
            {
              "servicePort": "summary"
            }
          ]
        }
      ]
    },
    {
      "id": "question_generation",
      "description": "Generate clarifying questions from all prepared context.",
      "invocations": [
        {
          "id": "questions",
          "service": "context-to-questions-json",
          "inputs": [
            {
              "servicePort": "context"
            }
          ],
          "outputs": [
            {
              "servicePort": "questions"
            }
          ]
        }
      ]
    },
    {
      "id": "analysis",
      "description": "Combine manual answers and prior context to generate analysis artifacts.",
      "invocations": [
        {
          "id": "analysis",
          "service": "answers-and-context-to-analysis-json",
          "inputs": [
            {
              "servicePort": "answers"
            },
            {
              "servicePort": "context"
            }
          ],
          "outputs": [
            {
              "servicePort": "risks"
            },
            {
              "servicePort": "team-leverage"
            }
          ]
        }
      ]
    },
    {
      "id": "render_reports",
      "description": "Render the final JSON analysis artifacts into Markdown.",
      "invocations": [
        {
          "id": "risks",
          "service": "json-to-markdown-render",
          "config": {
            "template": "templates/risks.mustache"
          },
          "inputs": [
            {
              "servicePort": "data"
            }
          ],
          "outputs": [
            {
              "servicePort": "markdown"
            }
          ]
        },
        {
          "id": "team",
          "service": "json-to-markdown-render",
          "config": {
            "template": "templates/team-leverage.mustache"
          },
          "inputs": [
            {
              "servicePort": "data"
            }
          ],
          "outputs": [
            {
              "servicePort": "markdown"
            }
          ]
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "pipeline:input.canvas",
      "to": "prepare_context.canvas.canvas",
      "label": "Pass the canvas into the deterministic converter."
    },
    {
      "from": "pipeline:input.team-principles",
      "to": "prepare_context.principles.documents",
      "label": "Provide the team principles folder for summarization."
    },
    {
      "from": "pipeline:input.job-descriptions",
      "to": "prepare_context.jobs.documents",
      "label": "Provide the job descriptions folder for summarization."
    },
    {
      "from": "prepare_context.canvas.relationships",
      "to": "question_generation.questions.context",
      "label": "Use the simplified canvas JSON as synthesis context."
    },
    {
      "from": "prepare_context.principles.summary",
      "to": "question_generation.questions.context",
      "label": "Use the summarized principles as synthesis context."
    },
    {
      "from": "prepare_context.jobs.summary",
      "to": "question_generation.questions.context",
      "label": "Use the summarized job descriptions as synthesis context."
    },
    {
      "from": "question_generation.questions.questions",
      "to": "pipeline:output.questions",
      "label": "Expose the generated questions for manual answering."
    },
    {
      "from": "pipeline:input.manual-answers",
      "to": "analysis.analysis.answers",
      "label": "Provide the manual answers for downstream analysis."
    },
    {
      "from": "prepare_context.canvas.relationships",
      "to": "analysis.analysis.context",
      "label": "Reuse the canvas context during analysis."
    },
    {
      "from": "prepare_context.principles.summary",
      "to": "analysis.analysis.context",
      "label": "Reuse the principles context during analysis."
    },
    {
      "from": "prepare_context.jobs.summary",
      "to": "analysis.analysis.context",
      "label": "Reuse the job description context during analysis."
    },
    {
      "from": "question_generation.questions.questions",
      "to": "analysis.analysis.context",
      "label": "Use the previously generated questions as context for analysis."
    },
    {
      "from": "analysis.analysis.risks",
      "to": "render_reports.risks.data",
      "label": "Render the structured risk analysis to Markdown."
    },
    {
      "from": "analysis.analysis.team-leverage",
      "to": "render_reports.team.data",
      "label": "Render the team leverage analysis to Markdown."
    },
    {
      "from": "render_reports.risks.markdown",
      "to": "pipeline:output.risks-report",
      "label": "Expose the risk report as pipeline output."
    },
    {
      "from": "render_reports.team.markdown",
      "to": "pipeline:output.team-leverage-report",
      "label": "Expose the team leverage report as pipeline output."
    }
  ]
}
