{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linksmith.dev/schemas/markdown-corpus.schema.json",
  "title": "Markdown Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "items",
    "sourceRefs"
  ],
  "properties": {
    "artifactType": {
      "const": "markdown-corpus"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "fileName",
          "relativePath",
          "content"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "relativePath"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
