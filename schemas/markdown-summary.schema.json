{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linksmith.dev/schemas/markdown-summary.schema.json",
  "title": "Markdown Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "keyPoints", "sourceRefs"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "keyPoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "section": { "type": "string" }
      }
    }
  }
}
