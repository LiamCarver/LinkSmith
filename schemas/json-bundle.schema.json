{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linksmith.dev/schemas/json-bundle.schema.json",
  "title": "JSON Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "items",
    "sourceRefs"
  ],
  "properties": {
    "artifactType": {
      "const": "json-bundle"
    },
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "fileName",
          "relativePath",
          "data"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "relativePath"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
