{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linksmith.dev/schemas/pipeline.schema.json",
  "title": "LinkSmith Pipeline Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps", "edges"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipelinePort"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipelinePort"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "pipelinePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "mode", "cardinality"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["file", "directory", "artifact-ref"]
        },
        "cardinality": {
          "type": "string",
          "enum": ["one", "many"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "stepPortRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servicePort"],
      "properties": {
        "servicePort": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "service"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invocationResource"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepPortRef"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepPortRef"
          }
        }
      }
    },
    "invocationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "mode", "cardinality", "path"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["file", "directory", "artifact-ref"]
        },
        "cardinality": {
          "type": "string",
          "enum": ["one", "many"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invocations"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "description": {
          "type": "string"
        },
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/invocation"
          }
        }
      }
    },
    "edgeEndpoint": {
      "type": "string",
      "pattern": "^(pipeline:(input|output)\\.[a-zA-Z][a-zA-Z0-9_-]*|[a-zA-Z][a-zA-Z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9_-]*)$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/edgeEndpoint"
        },
        "to": {
          "$ref": "#/$defs/edgeEndpoint"
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
