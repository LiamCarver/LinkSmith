{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linksmith.dev/schemas/canvas-relationships.schema.json",
  "title": "Canvas Relationships",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups", "ungroupedNodes", "edges"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "ungroupedNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "groups", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fromNode", "toNode"],
      "properties": {
        "fromNode": { "type": "string", "minLength": 1 },
        "toNode": { "type": "string", "minLength": 1 },
        "fromGroupId": { "type": ["string", "null"] },
        "toGroupId": { "type": ["string", "null"] },
        "lowestSharedGroupId": { "type": ["string", "null"] }
      }
    }
  }
}
