{
  "id": "principles-jobs-canvas-effort-advisory-markdown",
  "name": "Principles Jobs Canvas Effort Advisory Markdown",
  "description": "Normalize principles and job specs Markdown folders plus one client-and-team canvas, bundle the resulting context, produce effort-distribution advisory JSON through an LLM-backed transformation, and render the result as Markdown.",
  "version": "0.1.0",
  "inputs": [
    {
      "name": "principles_docs",
      "type": "markdown-directory",
      "mode": "directory",
      "cardinality": "one",
      "description": "Company principles Markdown folder."
    },
    {
      "name": "job_specs_docs",
      "type": "markdown-directory",
      "mode": "directory",
      "cardinality": "one",
      "description": "Job specifications Markdown folder."
    },
    {
      "name": "context_canvas",
      "type": "obsidian-canvas",
      "mode": "file",
      "cardinality": "one",
      "description": "Combined client and team context canvas."
    }
  ],
  "outputs": [
    {
      "name": "advice",
      "type": "json-document",
      "mode": "file",
      "cardinality": "one",
      "description": "Structured effort-distribution advisory JSON."
    },
    {
      "name": "document",
      "type": "markdown-document",
      "mode": "file",
      "cardinality": "one",
      "description": "Rendered Markdown advisory report."
    }
  ],
  "steps": [
    {
      "id": "corpus",
      "description": "Convert Markdown source folders into deterministic JSON corpora.",
      "invocations": [
        {
          "id": "principles",
          "service": "principles-markdown-to-corpus"
        },
        {
          "id": "jobs",
          "service": "job-specs-markdown-to-corpus"
        }
      ]
    },
    {
      "id": "normalize",
      "description": "Convert the combined canvas into deterministic relationships JSON.",
      "invocations": [
        {
          "id": "context",
          "service": "context-canvas-to-relationships"
        }
      ]
    },
    {
      "id": "bundle",
      "description": "Bundle the principles corpus, job specs corpus, and context relationships into one provenance-preserving JSON artifact.",
      "invocations": [
        {
          "id": "context",
          "service": "advisory-sources-to-json-bundle"
        }
      ]
    },
    {
      "id": "advise",
      "description": "Generate effort-distribution advisory JSON from the bundled context.",
      "invocations": [
        {
          "id": "combined",
          "service": "bundled-advisory-context-to-effort-advice-json",
          "resources": [
            {
              "name": "prompt",
              "type": "mustache-template",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/effort-advisory.prompt.mustache",
              "description": "Prompt template for producing the effort-distribution advisory JSON."
            },
            {
              "name": "schema",
              "type": "json-document",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/effort-advisory.schema.json",
              "description": "Required JSON schema for the advisory output."
            }
          ]
        }
      ]
    },
    {
      "id": "render",
      "description": "Render the advisory JSON into Markdown.",
      "invocations": [
        {
          "id": "report",
          "service": "json-to-markdown-renderer",
          "resources": [
            {
              "name": "template",
              "type": "mustache-template",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/effort-advisory-report.template.mustache",
              "description": "Mustache template used to render the advisory report."
            }
          ]
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "pipeline:input.principles_docs",
      "to": "corpus.principles.documents"
    },
    {
      "from": "pipeline:input.job_specs_docs",
      "to": "corpus.jobs.documents"
    },
    {
      "from": "pipeline:input.context_canvas",
      "to": "normalize.context.canvas"
    },
    {
      "from": "corpus.principles.corpus",
      "to": "bundle.context.documents"
    },
    {
      "from": "corpus.jobs.corpus",
      "to": "bundle.context.documents"
    },
    {
      "from": "normalize.context.relationships",
      "to": "bundle.context.documents"
    },
    {
      "from": "bundle.context.bundle",
      "to": "advise.combined.data"
    },
    {
      "from": "advise.combined.result",
      "to": "pipeline:output.advice"
    },
    {
      "from": "advise.combined.result",
      "to": "render.report.data"
    },
    {
      "from": "render.report.document",
      "to": "pipeline:output.document"
    }
  ]
}
