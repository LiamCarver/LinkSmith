{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "effort_distribution_overview",
    "focus_areas"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "effort_distribution_overview": {
      "type": "string",
      "minLength": 1
    },
    "focus_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "why_it_matters",
          "recommended_effort_split",
          "principle_relevance",
          "role_implications",
          "recommended_actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "recommended_effort_split": {
            "type": "string",
            "minLength": 1
          },
          "principle_relevance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role_implications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
