{
  "services": [
    {
      "id": "team-canvas-to-relationships",
      "kind": "transform",
      "deterministic": true,
      "description": "Convert the team canvas file into relationships JSON.",
      "entrypoint": "docker://team-canvas-to-relationships",
      "inputs": [
        {
          "name": "canvas",
          "type": "obsidian-canvas",
          "mode": "file",
          "cardinality": "one"
        }
      ],
      "outputs": [
        {
          "name": "relationships",
          "type": "canvas-relationships",
          "mode": "file",
          "cardinality": "one",
          "schemaRef": "schemas/canvas-relationships.schema.json"
        }
      ]
    },
    {
      "id": "client-canvas-to-relationships",
      "kind": "transform",
      "deterministic": true,
      "description": "Convert the client canvas file into relationships JSON.",
      "entrypoint": "docker://client-canvas-to-relationships",
      "inputs": [
        {
          "name": "canvas",
          "type": "obsidian-canvas",
          "mode": "file",
          "cardinality": "one"
        }
      ],
      "outputs": [
        {
          "name": "relationships",
          "type": "canvas-relationships",
          "mode": "file",
          "cardinality": "one",
          "schemaRef": "schemas/canvas-relationships.schema.json"
        }
      ]
    },
    {
      "id": "canvas-relationships-to-json-bundle",
      "kind": "transform",
      "deterministic": true,
      "description": "Bundle multiple canvas-relationships JSON files into one deterministic provenance-preserving JSON artifact.",
      "entrypoint": "docker://canvas-relationships-to-json-bundle",
      "inputs": [
        {
          "name": "documents",
          "type": "canvas-relationships",
          "mode": "file",
          "cardinality": "many"
        }
      ],
      "outputs": [
        {
          "name": "bundle",
          "type": "json-bundle",
          "mode": "file",
          "cardinality": "one",
          "schemaRef": "schemas/json-bundle.schema.json"
        }
      ]
    },
    {
      "id": "bundled-canvas-context-to-summary-json",
      "kind": "transform",
      "deterministic": false,
      "description": "Summarize a bundled two-canvas context artifact into structured combined summary JSON through the shared LLM transformer runtime.",
      "entrypoint": "docker://bundled-canvas-context-to-summary-json",
      "inputs": [
        {
          "name": "data",
          "type": "json-bundle",
          "mode": "file",
          "cardinality": "one"
        },
        {
          "name": "prompt",
          "type": "mustache-template",
          "mode": "file",
          "cardinality": "one"
        },
        {
          "name": "schema",
          "type": "json-document",
          "mode": "file",
          "cardinality": "one"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "json-document",
          "mode": "file",
          "cardinality": "one",
          "schemaRef": "pipelines/paired-canvas-bundle-summary-markdown/resources/combined-summary.schema.json"
        }
      ]
    },
    {
      "id": "json-to-markdown-renderer",
      "kind": "render",
      "deterministic": true,
      "description": "Render Markdown from JSON and a Mustache template.",
      "entrypoint": "docker://json-to-markdown-renderer",
      "inputs": [
        {
          "name": "data",
          "type": "json-document",
          "mode": "file",
          "cardinality": "one"
        },
        {
          "name": "template",
          "type": "mustache-template",
          "mode": "file",
          "cardinality": "one"
        }
      ],
      "outputs": [
        {
          "name": "document",
          "type": "markdown-document",
          "mode": "file",
          "cardinality": "one"
        }
      ]
    }
  ]
}
