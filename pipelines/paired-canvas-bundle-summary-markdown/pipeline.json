{
  "id": "paired-canvas-bundle-summary-markdown",
  "name": "Paired Canvas Bundle Summary Markdown",
  "description": "Normalize two Obsidian canvases, bundle their relationship JSON, summarize the combined context through an LLM-backed JSON transformation, and render the result as Markdown.",
  "version": "0.1.0",
  "inputs": [
    {
      "name": "team_canvas",
      "type": "obsidian-canvas",
      "mode": "file",
      "cardinality": "one",
      "description": "Team or principles-oriented source canvas."
    },
    {
      "name": "client_canvas",
      "type": "obsidian-canvas",
      "mode": "file",
      "cardinality": "one",
      "description": "Client or problem-space source canvas."
    }
  ],
  "outputs": [
    {
      "name": "summary",
      "type": "json-document",
      "mode": "file",
      "cardinality": "one",
      "description": "Structured combined summary JSON generated from both normalized canvases."
    },
    {
      "name": "document",
      "type": "markdown-document",
      "mode": "file",
      "cardinality": "one",
      "description": "Rendered Markdown report derived from the combined summary JSON."
    }
  ],
  "steps": [
    {
      "id": "normalize",
      "description": "Convert both raw canvases into deterministic relationships JSON.",
      "invocations": [
        {
          "id": "team",
          "service": "team-canvas-to-relationships"
        },
        {
          "id": "client",
          "service": "client-canvas-to-relationships"
        }
      ]
    },
    {
      "id": "bundle",
      "description": "Bundle the two relationship JSON files into one provenance-preserving context artifact.",
      "invocations": [
        {
          "id": "context",
          "service": "canvas-relationships-to-json-bundle"
        }
      ]
    },
    {
      "id": "summarize",
      "description": "Summarize the combined canvas context into structured JSON.",
      "invocations": [
        {
          "id": "combined",
          "service": "bundled-canvas-context-to-summary-json",
          "resources": [
            {
              "name": "prompt",
              "type": "mustache-template",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/combined-summary.prompt.mustache",
              "description": "Prompt template for summarizing the bundled normalized canvas context."
            },
            {
              "name": "schema",
              "type": "json-document",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/combined-summary.schema.json",
              "description": "Required JSON schema for the combined summary output."
            }
          ]
        }
      ]
    },
    {
      "id": "render",
      "description": "Render the combined summary JSON into Markdown.",
      "invocations": [
        {
          "id": "report",
          "service": "json-to-markdown-renderer",
          "resources": [
            {
              "name": "template",
              "type": "mustache-template",
              "mode": "file",
              "cardinality": "one",
              "path": "resources/combined-summary-report.template.mustache",
              "description": "Mustache template used to render the combined summary Markdown report."
            }
          ]
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "pipeline:input.team_canvas",
      "to": "normalize.team.canvas"
    },
    {
      "from": "pipeline:input.client_canvas",
      "to": "normalize.client.canvas"
    },
    {
      "from": "normalize.team.relationships",
      "to": "bundle.context.documents"
    },
    {
      "from": "normalize.client.relationships",
      "to": "bundle.context.documents"
    },
    {
      "from": "bundle.context.bundle",
      "to": "summarize.combined.data"
    },
    {
      "from": "summarize.combined.result",
      "to": "pipeline:output.summary"
    },
    {
      "from": "summarize.combined.result",
      "to": "render.report.data"
    },
    {
      "from": "render.report.document",
      "to": "pipeline:output.document"
    }
  ]
}
